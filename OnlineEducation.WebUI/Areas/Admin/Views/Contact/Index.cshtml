@model List<ResultContactDto>
@{
    ViewData["Title"] = "İletişim Sayfası";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{
    int count = 0;
}
<table class="table table-hover">
    <tr>
        <th>#</th>
        <th>Adres</th>
        <th>Telefon</th>
        <th>Email</th>
        <th>Harita Url</th>

        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.Address</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td><a href="@item.MapUrl" target="_blank" class="btn btn-outline-info">Haritada Göster</a> </td>
            <td>
                <a asp-action="DeleteContact" asp-controller="Contact" asp-area="Admin" asp-route-id="@item.ContactId" class="btn btn-outline-danger">Sil</a>
                <a asp-action="UpdateContact" asp-controller="Contact" asp-area="Admin" asp-route-id="@item.ContactId" class="btn btn-outline-info">Güncelle</a>


            </td>
        </tr>
    }
</table>

<br />
<a asp-action="CreateContact" asp-controller="Contact" asp-area="Admin" class="btn btn-outline-primary">Yeni İletişim Bilgisi Ekle</a>

