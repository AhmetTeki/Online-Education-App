@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Hakkımda Sayfası";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int caunt = 0;
}

<table class="table table-hover">
    <tr>
        <th>#</th>
        <th>Resim 1</th>
        <th>Resim 2</th>
        <th>Açıklama</th>
        <th>Madde 1</th>
        <th>Madde 2</th>
        <th>Madde 3</th>
        <th>Madde 4</th>
        <th></th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        caunt++;
        <tr>
            <td>@caunt</td>
            <td> <img src="@item.ImageUrl1" alt="Alternate Text" /></td>
            <td><img src="@item.ImageUrl2" alt="Alternate Text" /></td>
            <td>@item.Description</td>
            <td>@item.Item1</td>
            <td>@item.Item2</td>
            <td>@item.Item3</td>
            <td>@item.Item4</td>
            <td>
                <a  asp-area="Admin" asp-controller="About" asp-route-id="@item.AboutId" asp-action="UpdateAbout"  class="btn btn-outline-primary">Güncelle</a>
             </td>
            <td><a asp-area="Admin" asp-controller="About" asp-route-id="@item.AboutId" asp-action="DeleteAbout" class="btn btn-outline-primary">Sil</a> </td>
        </tr>
    }
</table><a  asp-area="Admin" asp-controller="About" asp-action="CreateAbout" class="btn btn-outline-info mt-3">Ekle</a>
